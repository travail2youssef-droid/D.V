# Export these variables in your shell or configure your hosting environment.
# Node does not automatically load this file.
PORT=3000
ADMIN_USER=
ADMIN_PASSWORD=
# Optional absolute directory for persistent data outside the checkout:
# DATA_DIR=/path/to/persistent/data
# Number of reverse proxies in front of Node. Set to 1 behind nginx/Caddy so that rate
# limits and the Secure cookie flag use the real client IP. Leave 0 if exposed directly.
TRUST_PROXY_HOPS=0
# Comma-separated origins allowed to call the API cross-site. Leave unset for a
# same-origin deployment (the default emits no CORS headers at all).
# CORS_ORIGIN=https://votre-site.fr
# Allow the AI/webhook endpoints to reach private/LAN hosts (self-hosted n8n). Off by
# default: DNS is resolved and pinned; private/reserved targets and HTTP redirects are refused.
ALLOW_PRIVATE_WEBHOOKS=0
# Maximum simultaneous admin live streams.
SSE_MAX_CLIENTS=32
